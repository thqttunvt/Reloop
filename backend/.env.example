# Chế độ chạy: local (dev trên máy) | aws
STAGE=local
PORT=3001
# Xác thực: local (header x-dev-user) | cognito
AUTH_MODE=local
# Tên bảng DynamoDB — chỉ dùng khi STAGE=aws (Terraform đặt sẵn cho Lambda)
# TABLE_NAME=reloop-core-table
# Ảnh thiết bị trên S3 — để trống thì tắt upload ảnh (tin vẫn đăng được).
# Muốn dùng S3 thật khi chạy local: đặt bucket + AWS_PROFILE có quyền.
# IMAGE_BUCKET=reloop-device-images
# AI phân tích ảnh (Bedrock) — để trống thì tắt AI, người dùng nhập tay.
# AI_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
