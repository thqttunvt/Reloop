# Chế độ chạy: local (dev trên máy) | aws
STAGE=local
PORT=3001
# Xác thực: local (header x-dev-user) | cognito
AUTH_MODE=local
# Tài khoản ngân hàng ReLoop dùng để sinh VietQR (mã BIN ngân hàng, ví dụ MB Bank = 970422)
BANK_BIN=970422
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_NAME=RELOOP DEMO
# Bí mật webhook ngân hàng (KHÔNG commit giá trị thật)
BANK_WEBHOOK_SECRET=dev-secret
